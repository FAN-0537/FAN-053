%% main-filetools.py 代码架构图
%% Mermaid flowchart，可直接粘贴到支持 Mermaid 的渲染器查看
flowchart TD

    subgraph CFG["配置层"]
        C1["config.ini<br/>[llm] api_key / base_url<br/>model / temperature"]
        C2["BASE_DIR<br/>Path(__file__).parent"]
        C3["OpenAI client<br/>api_key + base_url"]
        C1 --> C3
        C2 --> C1
    end

    subgraph ENTRY["程序入口"]
        M1["main()<br/>REPL 主循环"]
        M2["SYSTEM_PROMPT<br/>系统提示词"]
        M1 --> M2
    end

    subgraph LOOP["对话与工具调用循环"]
        L1["input 读取用户问题<br/>exit 退出"]
        L2["history 追加 user 消息"]
        L3["client.chat.completions.create<br/>传入 messages + tools"]
        L4{"msg.tool_calls<br/>是否存在工具调用?"}
        L5["history 追加 assistant<br/>含 tool_calls"]
        L6["json.loads 解析 arguments"]
        L7["execute_tool 执行"]
        L8["history 追加 tool 结果<br/>tool_call_id 关联"]
        L9["打印 AI 回复<br/>history 追加 assistant"]
        L1 --> L2 --> L3 --> L4
        L4 -- 是 --> L5 --> L6 --> L7 --> L8 --> L3
        L4 -- 否 --> L9
    end

    subgraph DISPATCH["工具调度层"]
        D1["tools 列表<br/>11 个 function schema"]
        D2["TOOL_FUNCTIONS 字典<br/>name -> 函数映射"]
        D3["execute_tool(name, arguments)<br/>未知工具/异常统一捕获"]
        D1 --> D3
        D2 --> D3
    end

    subgraph UTIL["公共工具函数"]
        U1["_ok(**data)<br/>JSON 成功响应"]
        U2["_err(message)<br/>JSON 错误响应"]
        U3["_path(value)<br/>expanduser + resolve"]
        U4["_detect_text_encoding(path)<br/>BOM/UTF-8/GBK 探测"]
        U5["_guard_destructive(target)<br/>根目录与 cwd 保护"]
        U6["MAX_TEXT_FILE_BYTES<br/>10 MB 上限"]
    end

    subgraph TOOLS["文件系统能力（实现函数）"]
        T1["is_leap_year / check_leap_year<br/>闰年判断"]
        T2["get_current_directory<br/>当前工作目录"]
        T3["list_directory<br/>目录列举+排序"]
        T4["get_file_type<br/>扩展名/MIME/文本判定"]
        T5["read_file<br/>文本读取+截断"]
        T6["create_file<br/>独占创建不覆盖"]
        T7["edit_file<br/>overwrite/append/replace"]
        T8["create_directory<br/>递归建目录"]
        T9["delete_directory<br/>shutil.rmtree"]
        T10["delete_file<br/>unlink"]
        T11["rename_item<br/>同目录重命名"]
    end

    subgraph IO["系统与标准库"]
        S1["pathlib.Path"]
        S2["os.scandir"]
        S3["shutil.rmtree"]
        S4["mimetypes.guess_type"]
        S5["json.dumps / json.loads"]
        S6["configparser"]
        S7["datetime.fromtimestamp"]
    end

    C3 --> L3
    M1 --> L1
    L7 --> D3
    D3 --> T1 & T2 & T3 & T4 & T5 & T6 & T7 & T8 & T9 & T10 & T11

    T2 & T3 & T4 & T5 & T6 & T7 & T8 & T9 & T10 & T11 --> U1
    T2 & T3 & T4 & T5 & T6 & T7 & T8 & T9 & T10 & T11 --> U2
    T3 & T4 & T5 & T6 & T7 & T8 & T9 & T10 & T11 --> U3
    T4 & T5 & T7 --> U4
    T9 & T10 & T11 --> U5
    T5 --> U6

    U3 --> S1
    T3 --> S2
    T9 --> S3
    T4 --> S4
    U1 --> S5
    U2 --> S5
    L6 --> S5
    C1 --> S6
    T3 --> S7
