{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Bazi-MCP": {
      "type": "remote",
      "url": "https://mcp.api-inference.modelscope.net/YOUR_ENDPOINT_ID/mcp",
      "enabled": true
    },
    "pet-hospital": {
      "type": "local",
      "command": [
        "python",
        "pethospitalMCP/pet-hospital-mcp-teaching-main/pet-hospital-mcp-server/server.py"
      ],
      "environment": {
        "PYTHONUTF8": "1"
      },
      "enabled": true
    },
    "anythingllm": {
      "type": "local",
      "command": [
        "python",
        "anythingllm_mcp1/server.py"
      ],
      "environment": {
        "PYTHONUTF8": "1"
      },
      "enabled": true
    }
  }
}
